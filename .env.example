# URL privada del core. Nunca usar NEXT_PUBLIC_ para no exponerla al navegador.
CONDORJUY_API_URL=http://localhost:5001
# Cloudflare Turnstile public site key for feedback and community reports.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google AdSense. Leave empty to disable ads in local/development environments.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_ID=XXXXXXXXXX
